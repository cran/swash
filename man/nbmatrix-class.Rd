\encoding{UTF-8}
\name{nbmatrix-class}
\docType{class}
\alias{nbmatrix-class}
\alias{print,nbmatrix-method}
\alias{show,nbmatrix-method}
\alias{summary,nbmatrix-method}
\alias{nbstat,nbmatrix-method}
\alias{plot,nbmatrix-method}

\title{Class \code{"nbmatrix"}}

\description{
The class \code{"nbmatrix"} contains the results of a neighborhood matrix analysis,
built by the \code{\link{nbmatrix}} function and the \code{"nbmatrix"} methods. 
Use \code{summary(nbmatrix)} and \code{plot(nbmatrix)} for results summary and plotting, respectively.
}

\section{Objects from the Class}{
Objects may be created by the function \code{nbmatrix}.
}

\section{Slots}{
  \describe{
    \item{\code{nb}}{Object of class \code{"nb"}: Neighborhood matrix list generated by \code{spdep::poly2nb}}
    \item{\code{nbmat}}{Object of class \code{"data.frame"}: Linear neighborhood matrix calculated from the \code{nb} list }
    \item{\code{weights}}{Object of class \code{"listw"}: Spatial weights generated by \code{spdep::nb2listw} }
    \item{\code{nbcount}}{Object of class \code{"data.frame"}: Table with the number of neighbors }
    \item{\code{regions_col_name}}{Object of class \code{"character"}: Column name which represents the unique ID of the polygon features }
    \item{\code{geodata}}{Object of class \code{"sf"}: Original geodata (\code{sf} object) with unique ID and \code{"geometry"} columns }
    \item{\code{N}}{Object of class \code{"numeric"}: No. of features (total, with valid unique ID, with valid geometry) }
    \item{\code{N_neighbors}}{Object of class \code{"numeric"}: Total and average no. of neighbors }
    \item{\code{polygon_data}}{Object of class \code{"sf"}: Geodata (\code{sf} object containing the geometries and the analysis column) }
    \item{\code{nbmat_data}}{Object of class \code{"data.frame"}: Neighborhood matrix data }
    \item{\code{nbmat_data_aggregate}}{Object of class \code{"data.frame"}: Aggregated neighborhood matrix data }
    \item{\code{func}}{Object of class \code{"character"}: Function used for the calculation of the neighborhood statistic }
    \item{\code{moran}}{Object of class \code{"list"}: Results of the Global Moran's I calculation (estimate, expected value, etc.) }
    \item{\code{getisord}}{Object of class \code{"list"}: Results of the Global Getis-Ord calculation (estimate, expected value, etc.) }
    \item{\code{gstar}}{Object of class \code{"list"}: Results of the Local Gi* calculation (\code{data.frame} with estimates and expected values etc., analysis configuration) }
    \item{\code{data_col}}{Object of class \code{"character"}: Column name which represents the analysis data for nbstat, Moran's I, etc. }
    \item{\code{config}}{Object of class \code{"list"}: Configuration details with respect to zero policy of the neighborhood matrix etc. }
    \item{\code{timestamp}}{Object of class \code{"list"}: Time stamps of any update of the instance }
  }
}

\section{Methods}{
  \describe{
    \item{nbstat}{\code{signature(object = "nbmatrix")}: Calculates a specified statistic for the neighboring regions. }
    \item{moran}{\code{signature(object = "nbmatrix")}: Calculates the Global Moran's I statistic for the neighborhood matrix }
    \item{getisord}{\code{signature(object = "nbmatrix")}: Calculates the Global Getis-Ord statistic for the neighborhood matrix }
    \item{gstar}{\code{signature(object = "nbmatrix")}: Calculates the Local Getis-Ord Gi* statistic for the neighborhood matrix }
    \item{plot}{\code{signature(x = "nbmatrix")}: Plots the results of the calculation (Neighborhood statistic or Local Getis-Ord Gi*) }
    \item{print}{\code{signature(x = "nbmatrix")}: Prints an \code{nbmatrix} object; use \code{summary(nbmatrix)} for results }
    \item{show}{\code{signature(object = "nbmatrix")}: Prints an \code{nbmatrix} object; use \code{summary(nbmatrix)} for results }
    \item{summary}{\code{signature(object = "nbmatrix")}: Prints a summary of \code{nbmatrix} objects (results of the spatial statistics calculation) }
	 }
}

